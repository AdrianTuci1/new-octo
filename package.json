{
  "name": "octomus-launcher-rs-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "sh ./scripts/tauri-dev.sh",
    "build": "tsc && vite build",
    "test": "sh ./scripts/test-all.sh",
    "test:js": "npm run test:chat-logic && npm run test:composer-skills && npm run test:model-providers",
    "test:chat-logic": "node --test --experimental-specifier-resolution=node tests/chat/*.test.ts tests/launcher/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:integration": "cargo test --manifest-path src-tauri/Cargo.toml --tests",
    "test:agent-evals": "cargo test --manifest-path src-tauri/Cargo.toml ai::agent::evals",
    "test:agent-evals:live": "sh ./scripts/test-model-env.sh cargo test --manifest-path src-tauri/Cargo.toml ai::agent::evals::live -- --ignored --nocapture --test-threads=1",
    "test:composer-skills": "node --test tests/skills-composer/*.test.mjs",
    "test:model-providers": "node --test tests/model-providers/*.test.mjs",
    "test:model-env": "sh ./scripts/test-model-env.sh",
    "preview": "vite preview",
    "tauri": "sh ./scripts/tauri-cli.sh",
    "release:cli": "sh ./scripts/release-cli.sh",
    "release:cli-linux": "sh ./scripts/release-cli-linux.sh",
    "release:desktop": "sh ./scripts/release-desktop.sh",
    "release:aws": "sh ./scripts/release-aws.sh",
    "release:dmg": "sh ./scripts/release-dmg.sh",
    "release:exe": "sh ./scripts/release-exe.sh",
    "release:all": "sh ./scripts/release-all.sh",
    "start": "sh ./scripts/dev-start.sh",
    "stop": "sh ./scripts/dev-stop.sh",
    "logs": "tail -f .dev.log"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "lucide-react": "^0.575.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
