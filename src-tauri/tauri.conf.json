{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octomus",
  "version": "0.1.0",
  "identifier": "com.octomus.launcher.prototype",
  "mainBinaryName": "octomus_launcher_prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": ["icons/icon.icns", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Octomus",
        "width": 608,
        "height": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "create": false,
        "title": "Settings",
        "url": "index.html?panel=settings",
        "width": 1120,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "maximizable": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        },
        "transparent": false,
        "shadow": true
      },
      {
        "label": "onboarding",
        "create": false,
        "title": "Onboarding",
        "url": "index.html?panel=onboarding",
        "width": 1120,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true
      }
    ]
  }
}
