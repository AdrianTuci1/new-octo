# Copy this to .env and fill in the values.
# We need 3 env files

# .env
OCTOMUS_UPDATER_ENDPOINTS=https://<R2_PUBLIC_BASE_URL>/updater/{{target}}-{{arch}}.json
OCTOMUS_UPDATER_PUBKEY=
OCTOMUS_UPDATER_TIMEOUT_MS=

# release.env
AWS_REGION=eu-central-1

R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=

TAURI_SIGNING_PRIVATE_KEY=

# tests.env
OCTOMUS_AI_API_KEY=
OCTOMUS_AI_BASE_URL=https://api.openai.com/v1
OCTOMUS_AI_MODEL=gpt-4o-mini